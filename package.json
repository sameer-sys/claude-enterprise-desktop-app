{
  "name": "sameer-ai-workspace",
  "version": "1.0.0",
  "description": "Sameer AI Workspace — Autonomous AI Assistant Desktop App",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron electron/main.js --dev",
    "electron:prod": "electron electron/main.js",
    "electron:build": "electron-builder --win --x64",
    "connector:check": "node scripts/connector-checker.cjs"
  },
  "build": {
    "appId": "com.sameer.claude-enterprise",
    "productName": "Sameer AI Workspace",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sameer AI Workspace"
    }
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "clsx": "^2.1.1",
    "imapflow": "^2.0.5",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "next": "14.2.18",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": "22.x"
  }
}
